{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-write.sh\"",
            "if": "Bash(git *)",
            "timeout": 10,
            "statusMessage": "Kiểm tra lệnh git..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git init:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)"
    ]
  }
}
